// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DominantFoot {
  IZQUIERDO
  DERECHO
  AMBOS
}

enum AttendanceStatus {
  CONFIRMADO
  AUSENCIA_JUSTIFICADA
  AUSENCIA_NO_JUSTIFICADA
  TARDE
}

enum MatchStatus {
  PROGRAMADO
  JUGADO
  CANCELADO
}

enum Competition {
  AMISTOSO
  LIGA
  COPA
}

enum PlayerAvailability {
  DISPONIBLE
  LESIONADO
  SANCIONADO
}

enum MatchEventType {
  GOL
  ASISTENCIA
  TARJETA_AMARILLA
  TARJETA_ROJA
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Player {
  id                String            @id @default(cuid())
  name              String
  nickname          String?
  position          String?
  secondaryPosition String?
  birthDate         DateTime?
  dominantFoot      DominantFoot?
  phone             String?
  club              String?
  inSquad           Boolean           @default(true)
  onTrial           Boolean           @default(false)
  enrolled          Boolean           @default(true)
  availability      PlayerAvailability @default(DISPONIBLE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  attendances       TrainingAttendance[]
  callups           MatchCallup[]
  fines             Fine[]
  matchEvents       MatchEvent[]
  lineupSlots       MatchLineupSlot[]
}

model Coach {
  id        String   @id @default(cuid())
  name      String
  club      String?
  formation String?
  notes     String?
  createdAt DateTime @default(now())
}

model Referee {
  id        String   @id @default(cuid())
  name      String
  notes     String?
  createdAt DateTime @default(now())
}

model Rival {
  id        String   @id @default(cuid())
  name      String
  contact   String?
  venue     String?
  address   String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  matches   Match[]
  scoutings Scouting[]
}

model Training {
  id          String                @id @default(cuid())
  date        DateTime
  duration    Int?
  notes       String?
  createdAt   DateTime              @default(now())
  attendances    TrainingAttendance[]
  exercises      TrainingExercise[]
  materialChecks TrainingMaterialCheck[]
  fines          Fine[]
}

model Material {
  id             String                  @id @default(cuid())
  name           String
  quantity       Int?
  createdAt      DateTime                @default(now())
  exercises      ExerciseMaterial[]
  trainingChecks TrainingMaterialCheck[]
}

model Exercise {
  id          String             @id @default(cuid())
  name        String
  duration    Int?
  explanation String?
  imageUrl    String?
  imageUrl2   String?
  createdAt   DateTime           @default(now())
  materials   ExerciseMaterial[]
  sessions    TrainingExercise[]
}

model ExerciseMaterial {
  id         String   @id @default(cuid())
  exerciseId String
  materialId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, materialId])
}

model TrainingExercise {
  id         String    @id @default(cuid())
  trainingId String
  exerciseId String?
  name       String
  duration   Int?
  training   Training  @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  exercise   Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
}

model TrainingMaterialCheck {
  id         String   @id @default(cuid())
  trainingId String
  materialId String
  collected  Boolean  @default(false)
  training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([trainingId, materialId])
}

model TrainingAttendance {
  id         String           @id @default(cuid())
  trainingId String
  playerId   String
  status     AttendanceStatus @default(CONFIRMADO)
  training   Training         @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  player     Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([trainingId, playerId])
}

model Match {
  id          String      @id @default(cuid())
  rivalId     String
  date        DateTime
  isHome      Boolean     @default(true)
  competition Competition @default(LIGA)
  ourScore    Int?
  rivalScore  Int?
  status      MatchStatus @default(PROGRAMADO)
  notes       String?
  createdAt   DateTime    @default(now())
  rival       Rival       @relation(fields: [rivalId], references: [id], onDelete: Restrict)
  callups     MatchCallup[]
  fines       Fine[]
  events      MatchEvent[]
  lineupSlots MatchLineupSlot[]
}

model Fine {
  id         String       @id @default(cuid())
  playerId   String
  trainingId String?
  matchId    String?
  conceptId  String?
  amount     Float
  comment    String?
  paid       Boolean      @default(false)
  createdAt  DateTime     @default(now())
  player     Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  training   Training?    @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  match      Match?       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  concept    FineConcept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)
}

model FineConcept {
  id        String   @id @default(cuid())
  name      String
  category  String?
  amount    Float
  createdAt DateTime @default(now())
  fines     Fine[]
}

model MatchCallup {
  id          String  @id @default(cuid())
  matchId     String
  playerId    String
  called      Boolean @default(false)
  unavailable Boolean @default(false)
  match       Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player      Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
}

model MatchEvent {
  id        String         @id @default(cuid())
  matchId   String
  playerId  String
  type      MatchEventType
  createdAt DateTime       @default(now())
  match     Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player    Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model MatchLineupSlot {
  id       String  @id @default(cuid())
  matchId  String
  slotId   String
  playerId String?
  match    Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player   Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@unique([matchId, slotId])
}

model DefaultFormation {
  id        String   @id
  slots     String[]
  updatedAt DateTime @updatedAt
}

model Scouting {
  id             String   @id @default(cuid())
  rivalId        String
  date           DateTime
  scoutName      String?
  opponent       String?
  bpOfensivo     String?
  bpDefensivo    String?
  salidaBalon    String?
  notes          String?
  createdAt      DateTime @default(now())
  rival          Rival    @relation(fields: [rivalId], references: [id], onDelete: Cascade)
}
