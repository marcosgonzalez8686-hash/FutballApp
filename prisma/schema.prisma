// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DominantFoot {
  IZQUIERDO
  DERECHO
  AMBOS
}

enum AttendanceStatus {
  CONFIRMADO
  AUSENCIA_JUSTIFICADA
  AUSENCIA_NO_JUSTIFICADA
  TARDE
}

enum MatchStatus {
  PROGRAMADO
  JUGADO
  CANCELADO
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Player {
  id                String            @id @default(cuid())
  name              String
  nickname          String?
  position          String?
  secondaryPosition String?
  birthDate         DateTime?
  dominantFoot      DominantFoot?
  phone             String?
  club              String?
  inSquad           Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  attendances       TrainingAttendance[]
}

model Coach {
  id        String   @id @default(cuid())
  name      String
  club      String?
  formation String?
  notes     String?
  createdAt DateTime @default(now())
}

model Referee {
  id        String   @id @default(cuid())
  name      String
  notes     String?
  createdAt DateTime @default(now())
}

model Rival {
  id        String   @id @default(cuid())
  name      String
  notes     String?
  createdAt DateTime @default(now())
  matches   Match[]
}

model Training {
  id          String                @id @default(cuid())
  date        DateTime
  duration    Int?
  notes       String?
  createdAt   DateTime              @default(now())
  attendances TrainingAttendance[]
  exercises   TrainingExercise[]
}

model Material {
  id        String             @id @default(cuid())
  name      String
  quantity  Int?
  createdAt DateTime           @default(now())
  exercises ExerciseMaterial[]
}

model Exercise {
  id          String             @id @default(cuid())
  name        String
  duration    Int?
  explanation String?
  imageUrl    String?
  imageUrl2   String?
  createdAt   DateTime           @default(now())
  materials   ExerciseMaterial[]
  sessions    TrainingExercise[]
}

model ExerciseMaterial {
  id         String   @id @default(cuid())
  exerciseId String
  materialId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, materialId])
}

model TrainingExercise {
  id         String    @id @default(cuid())
  trainingId String
  exerciseId String?
  name       String
  duration   Int?
  training   Training  @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  exercise   Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
}

model TrainingAttendance {
  id         String           @id @default(cuid())
  trainingId String
  playerId   String
  status     AttendanceStatus @default(CONFIRMADO)
  training   Training         @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  player     Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([trainingId, playerId])
}

model Match {
  id         String      @id @default(cuid())
  rivalId    String
  date       DateTime
  isHome     Boolean     @default(true)
  ourScore   Int?
  rivalScore Int?
  status     MatchStatus @default(PROGRAMADO)
  notes      String?
  createdAt  DateTime    @default(now())
  rival      Rival       @relation(fields: [rivalId], references: [id], onDelete: Restrict)
}
